# Copy this file to `.env` and fill in your actual values.
# `.env` is gitignored so your secrets never leak.

OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: set to "false" to skip loading the CrossEncoder reranker
# (BAAI/bge-reranker-base ~1.1GB). Useful for constrained cloud tiers.
# Defaults to "true" (full quality).
# ENABLE_RERANK=true
